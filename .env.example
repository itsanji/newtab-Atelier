# Copy to .env and edit: cp .env.example .env

# Required. The address people use to reach the server, with no trailing slash.
# Used in emails, share links and the Google redirect URI.
PUBLIC_URL=http://localhost:8787

# Required. Password for the bundled Postgres container (compose builds DATABASE_URL from it).
# Use letters and digits only, or it will need URL-encoding. Example: openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# Required. At least 32 characters. Generate with: openssl rand -base64 48
SESSION_SECRET=

# Host port to publish (the server always listens on 8787 inside the container). Default 8787.
PORT=8787

# Address the published port binds to on the host. 0.0.0.0 exposes it on every interface; set
# 127.0.0.1 when a reverse proxy on the same host is the only way in. REQUIRED with TRUST_PROXY=true.
BIND_ADDRESS=0.0.0.0

# Set to true only when a reverse proxy (Caddy, nginx) is in front of the server and appends the
# client address to X-Forwarded-For. Leave false when the port is exposed directly: the login rate
# limit would otherwise trust a header the client controls.
TRUST_PROXY=false

# Set to false to close sign-ups after you have created your accounts. Existing users can still
# sign in. Invited emails can only sign in if SMTP (email link) or Google is configured, because
# password sign-up is refused while sign-ups are closed.
ALLOW_SIGNUP=true

# Optional. Email for sign-in links and workspace invites. Set both or neither.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# SMTP_FROM=Atelier <atelier@example.com>

# Optional. Sign in with Google. Set both or neither.
# Authorised redirect URI: <PUBLIC_URL>/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
